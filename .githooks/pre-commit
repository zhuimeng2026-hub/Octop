#!/usr/bin/env bash
# Pre-commit gate (local, fast): backend format + lint + typecheck + a small
# smoke test subset. The full suite still runs in CI (`make all`); this gate
# exists so a local commit does not wait on the whole test matrix.
#
# Frontend steps (prettier + dashboard build) only run when dashboard sources
# actually changed, and can be switched off entirely with SKIP_FRONTEND=1 —
# server hosts that only ship the backend do not need a client build.
#
# Enable once per clone:  make install-hooks
# Bypass (emergency only): SKIP_PRECOMMIT=1 git commit ...
# Or: git commit --no-verify
set -euo pipefail

if [[ "${SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] SKIP_PRECOMMIT=1 — skipping checks"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Per-host overrides (not tracked). Create `.githooks/local.env` with e.g.
# `SKIP_FRONTEND=1` on machines that only build the backend.
if [[ -f "$ROOT/.githooks/local.env" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/.githooks/local.env"
fi

# Documentation-only commits do not need code checks or a dashboard build.
# Include deletions and both sides of renames when deciding what changed.
DOCS_ONLY=1
HAS_CHANGES=0
while IFS= read -r -d '' path; do
  HAS_CHANGES=1
  case "$path" in
    README.md|README.*.md) ;;
    *) DOCS_ONLY=0 ;;
  esac
done < <(git diff --cached --name-only --no-renames -z)
if [[ "$HAS_CHANGES" == "1" && "$DOCS_ONLY" == "1" ]]; then
  echo "[pre-commit] Documentation-only changes — skipping code checks and dashboard build"
  exit 0
fi

# Remember staged paths so we can re-add them after auto-format rewrites the worktree.
# Portable (bash 3.2+): avoid `mapfile` (bash 4+ only).
STAGED_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && STAGED_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR || true)

# Whether dashboard sources changed → whether the client build is needed at all.
FRONTEND_CHANGED=0
for f in "${STAGED_FILES[@]}"; do
  case "$f" in
    dashboard/*|src/octop/dashboard/*) FRONTEND_CHANGED=1 ;;
  esac
done

echo "[pre-commit] backend gate (format + lint + typecheck + smoke tests)"
make format
make lint
make typecheck
make test-smoke

# If format rewrote files that were already staged, refresh the index so the
# commit includes the formatted content (worktree vs index drift).
if ((${#STAGED_FILES[@]} > 0)); then
  existing=()
  for f in "${STAGED_FILES[@]}"; do
    if [[ -e "$f" || -L "$f" ]]; then
      existing+=("$f")
    fi
  done
  if ((${#existing[@]} > 0)); then
    git add -- "${existing[@]}"
  fi
fi

if [[ "${SKIP_FRONTEND:-}" == "1" ]]; then
  echo "[pre-commit] SKIP_FRONTEND=1 — skipping dashboard format and build"
elif [[ "$FRONTEND_CHANGED" == "1" ]]; then
  echo "[pre-commit] dashboard changed — formatting and building the SPA"
  make format-frontend
  (
    cd "$ROOT/dashboard"
    # vite's default heap cap is ~2 GB; raise it so the bundle does not OOM.
    NODE_OPTIONS="${NODE_OPTIONS:---max-old-space-size=4096}" npm run build
  )
else
  echo "[pre-commit] no dashboard changes — skipping dashboard format and build"
fi

echo "[pre-commit] all checks passed"
